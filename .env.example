# ---- Required -------------------------------------------------------------

# PostgreSQL connection string (dev: local Postgres on port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shadow_ai_dev

# Auth.js session encryption secret: openssl rand -base64 32
AUTH_SECRET=
# Required by Auth.js when not on Vercel (set to true behind your own proxy)
AUTH_TRUST_HOST=true

# HS256 signing secret for every signed link (survey, connect, sign-off, magic link, OAuth state): openssl rand -base64 32
TOKEN_SECRET=

# Base URL used in every link we mint and in OAuth redirect URIs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Field-level encryption at rest (survey answers, connector credentials, scan user lists): openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# ---- Access control -------------------------------------------------------

# After the first account exists, /register requires this code. Leave blank to keep registration closed.
REGISTRATION_INVITE_CODE=

# Bearer secret for the daily monitoring cron (/api/cron/monitor): openssl rand -hex 32
CRON_SECRET=

# ---- Email (Resend). Unset = links are logged to the server console in dev. ----
RESEND_API_KEY=
EMAIL_FROM="Shadowline <hello@example.com>"

# ---- Workspace connectors. Unset = provider hidden; demo scans available outside production. ----

# Google Cloud OAuth client (Web application). Authorized redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/connect/google/callback
# Enable the Admin SDK API. Scopes requested: admin.directory.user.readonly, admin.directory.user.security
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra app registration (multi-tenant). Redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/connect/microsoft/callback
# Application permissions: Directory.Read.All, Reports.Read.All (optional)
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# "true" forces demo scans on, "false" forces them off. Default: on outside production.
SCAN_DEMO_MODE=

# ---- Billing (Stripe). Unset = quotes are marked paid by hand. ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Optional AI assist for drafting finding recommendations (clearly labeled in the UI) ----
ANTHROPIC_API_KEY=
